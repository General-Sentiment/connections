# Copy to .env.local. Keep credentials out of source control.
APP_URL=http://127.0.0.1:3000
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=
# At least 32 random characters. Used to encrypt the HTTP-only session cookie.
SESSION_SECRET=
# Numeric group ID (required for publishing group-owned profiles).
ARENA_GROUP_ID=
# Explicit sample-data mode. No Are.na writes or simulated login.
DEMO_MODE=true


# Server-only group operator access token, or a sealed credential encrypted with SESSION_SECRET.
ARENA_OPERATOR_TOKEN=
ARENA_DIRECTORY_CREDENTIAL=
ARENA_ABOUT_BLOCK_ID=

# Live source for profile selection prompts
ARENA_PROMPTS_CHANNEL=prompts-lkiimgy92_0

# Destination for user-submitted prompts awaiting review
ARENA_PROPOSED_PROMPTS_CHANNEL=proposed-prompts
