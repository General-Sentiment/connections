# Copy to .env.local. Keep credentials out of source control.
APP_URL=http://127.0.0.1:3000
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=
# At least 32 random characters. Used to encrypt the HTTP-only session cookie.
SESSION_SECRET=
# Numeric group ID (required for publishing group-owned profiles).
ARENA_GROUP_ID=
# Main directory channel ID or slug. Public reads use this channel.
ARENA_DIRECTORY_CHANNEL=
# Durable local operational references; content remains on Are.na.
DATABASE_PATH=.data/connections.sqlite
# Explicit sample-data mode. No Are.na writes or simulated login.
DEMO_MODE=true
